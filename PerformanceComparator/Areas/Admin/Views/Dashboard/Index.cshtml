@model PerformanceComparator.ViewModels.Admin.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Funds</h5>
                <p class="card-text display-4">@Model.FundCount</p>
                <a asp-controller="Funds" asp-action="Index" class="btn btn-light btn-sm">Manage Funds</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Asset Classes</h5>
                <p class="card-text display-4">@Model.AssetClassCount</p>
                <a asp-controller="AssetClasses" asp-action="Index" class="btn btn-light btn-sm">Manage Asset Classes</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-bg-info">
            <div class="card-body">
                <h5 class="card-title">Content Blocks</h5>
                <p class="card-text display-4">@Model.ContentBlockCount</p>
                <a asp-controller="ContentBlocks" asp-action="Index" class="btn btn-light btn-sm">Manage Content</a>
            </div>
        </div>
    </div>
</div>
