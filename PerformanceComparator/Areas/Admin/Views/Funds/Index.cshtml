@model PerformanceComparator.ViewModels.Admin.FundIndexViewModel

@{
    ViewData["Title"] = "Funds";
}

<h1>Funds</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th style="width: 56px;">Logo</th>
            <th>Name</th>
            <th>Symbol</th>
            <th>Asset Class</th>
            <th>Provider</th>
            <th>Currency</th>
            <th>Benchmark</th>
            <th>NAV Records</th>
            <th style="width: 280px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Funds)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.LogoFileName))
                    {
                        <img src="~/uploads/logos/@item.LogoFileName" alt="@item.Name"
                             style="max-height: 32px; max-width: 48px;" />
                    }
                    else
                    {
                        <span class="text-muted small">N/A</span>
                    }
                </td>
                <td>@item.Name</td>
                <td><code>@item.Symbol</code></td>
                <td>@item.AssetClassName</td>
                <td>@(item.Provider ?? "—")</td>
                <td>@item.Currency</td>
                <td>@(item.IsBenchmark ? "Yes" : "No")</td>
                <td>@item.NavRecordCount</td>
                <td>
                    <a asp-action="UploadNav" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">NAV</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Funds.Any())
{
    <div class="alert alert-info">No funds yet. Create one to get started.</div>
}
