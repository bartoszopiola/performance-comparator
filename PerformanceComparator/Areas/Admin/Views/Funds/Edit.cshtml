@model PerformanceComparator.ViewModels.Admin.FundFormViewModel

@{
    ViewData["Title"] = "Edit Fund";
}

<h1>Edit Fund</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingLogoFileName" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Symbol" class="form-label"></label>
                <input asp-for="Symbol" class="form-control" />
                <span asp-validation-for="Symbol" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AssetClassId" class="form-label"></label>
                <select asp-for="AssetClassId" asp-items="Model.AssetClasses" class="form-select">
                    <option value="">-- Select Asset Class --</option>
                </select>
                <span asp-validation-for="AssetClassId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Provider" class="form-label"></label>
                <input asp-for="Provider" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Currency" class="form-label"></label>
                <input asp-for="Currency" class="form-control" maxlength="3" />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsBenchmark" class="form-check-input" />
                <label asp-for="IsBenchmark" class="form-check-label"></label>
            </div>

            <div class="mb-3">
                <label asp-for="LogoFile" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ExistingLogoFileName))
                {
                    <div class="mb-2">
                        <img src="~/uploads/logos/@Model.ExistingLogoFileName"
                             alt="Current logo" style="max-height: 64px;" class="border rounded" />
                        <div class="form-text">Current logo. Upload a new file to replace it.</div>
                    </div>
                }
                <input asp-for="LogoFile" type="file" class="form-control" accept=".png,.jpg,.jpeg,.webp" />
                <span asp-validation-for="LogoFile" class="text-danger"></span>
                <div class="form-text">PNG, JPG or WEBP, max 2 MB.</div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
