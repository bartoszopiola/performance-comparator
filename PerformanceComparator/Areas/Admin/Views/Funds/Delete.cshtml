@model PerformanceComparator.ViewModels.Admin.FundDetailViewModel

@{
    ViewData["Title"] = "Delete Fund";
}

<h1>Delete Fund</h1>

<h5>Are you sure you want to delete this fund?</h5>

<dl class="row mt-3">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Symbol</dt>
    <dd class="col-sm-9"><code>@Model.Symbol</code></dd>

    <dt class="col-sm-3">Asset Class</dt>
    <dd class="col-sm-9">@Model.AssetClassName</dd>
</dl>

@if (ViewBag.NavWarning != null)
{
    <div class="alert alert-warning">
        @ViewBag.NavWarning
    </div>
}

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
