@model PerformanceComparator.ViewModels.Admin.UploadNavViewModel

@{
    ViewData["Title"] = "Upload NAV CSV";
}

<h1>Upload NAV Data</h1>
<h5 class="text-muted">@Model.FundName (<code>@Model.Symbol</code>)</h5>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>Existing NAV records for this fund: <strong>@Model.ExistingNavCount</strong></p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="UploadNav" asp-route-id="@Model.FundId" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="file" class="form-label">CSV file</label>
                <input type="file" name="file" id="file" class="form-control" accept=".csv" required />
                <div class="form-text">Max 5 MB. Stooq format or simple (date,value) format.</div>
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
            <a asp-action="Details" asp-route-id="@Model.FundId" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>

<div class="mt-4">
    <h6>Supported formats</h6>
    <p class="mb-1"><strong>Stooq:</strong> <code>Data,Otwarcie,Najwyzszy,Najnizszy,Zamkniecie,Wolumen</code></p>
    <p><strong>Simple:</strong> <code>date,value</code> (or <code>date,nav</code>)</p>
</div>
