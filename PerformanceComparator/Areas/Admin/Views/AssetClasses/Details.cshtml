@model PerformanceComparator.ViewModels.Admin.AssetClassFormViewModel

@{
    ViewData["Title"] = "Asset Class Details";
}

<h1>Asset Class Details</h1>

<dl class="row mt-3">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
