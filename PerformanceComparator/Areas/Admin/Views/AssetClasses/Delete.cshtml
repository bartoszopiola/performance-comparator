@model PerformanceComparator.ViewModels.Admin.AssetClassFormViewModel

@{
    ViewData["Title"] = "Delete Asset Class";
}

<h1>Delete Asset Class</h1>

@if (ViewBag.CannotDelete != null)
{
    <div class="alert alert-danger">
        @ViewBag.CannotDelete
    </div>
}

<h5>Are you sure you want to delete this asset class?</h5>

<dl class="row mt-3">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
</dl>

@if (ViewBag.CannotDelete == null)
{
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
}
