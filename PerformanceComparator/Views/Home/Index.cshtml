@model PerformanceComparator.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="hero py-5 text-center mb-4">
    <h1 class="display-5 fw-bold">@Model.HeroTitle</h1>
    <p class="lead col-lg-8 mx-auto">@Html.Raw(Model.HeroBody)</p>
    <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
        <a asp-controller="Funds" asp-action="Index" class="btn btn-light btn-lg">Browse Funds</a>
        <a asp-controller="Compare" asp-action="Index" class="btn btn-outline-secondary btn-lg">Compare</a>
    </div>
</section>

<section class="mb-4">
    <h2>@Model.IntroTitle</h2>
    <p>@Html.Raw(Model.IntroBody)</p>
</section>

<section>
    <div class="card-grid card-grid--features">
        <article class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5">Funds</h3>
                <p class="card-text">Browse available funds and ETFs along with their performance metrics.</p>
                <a asp-controller="Funds" asp-action="Index" class="btn btn-outline-primary">Go to Funds</a>
            </div>
        </article>
        <article class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5">Compare</h3>
                <p class="card-text">Compare several funds against a chosen benchmark.</p>
                <a asp-controller="Compare" asp-action="Index" class="btn btn-outline-primary">Go to Compare</a>
            </div>
        </article>
    </div>
</section>
