@model PerformanceComparator.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="empty-state">
    <h1 class="display-6">Something went wrong</h1>
    <p class="lead">Sorry — an unexpected error occurred while processing your request.</p>

    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to home</a>
</section>
